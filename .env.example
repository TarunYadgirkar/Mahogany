# --- MongoDB Atlas (required) ---
# MUST be the hackathon sandbox cluster — submission eligibility depends on it.
MONGODB_URI="mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="mahogany"
# Automated Embedding model. Options: voyage-4-lite, voyage-4, voyage-4-large.
VOYAGE_MODEL="voyage-4-lite"

# --- Fireworks (required) — the fast route ---
# Hackathon credit code: MONGODB813
FIREWORKS_API_KEY="fw_..."
FIREWORKS_BASE_URL="https://api.fireworks.ai/inference/v1"
FW_MODEL_QUICK="accounts/fireworks/models/llama-v3p1-8b-instruct"
FW_MODEL_THOUGHTFUL="accounts/fireworks/models/llama-v3p3-70b-instruct"

# --- OpenRouter (required) — the route Fireworks competes against ---
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OR_MODEL_THOUGHTFUL="openai/gpt-4o-mini"
OR_MODEL_DEEP="anthropic/claude-3.5-sonnet"

# Verify every id above resolves before you build on it: npm run providers:check

# --- Demo identity ---
# One id for the whole demo. The live page and the seed script both read this.
DEMO_USER_ID="demo-user"

# --- ElevenLabs webhook tools ---
# Shared secret the agent sends as x-mahogany-secret. Leave empty to run open (local only —
# these routes mutate the tree, and a public URL without this lets anyone fork into your demo).
TOOL_SECRET=""
PUBLIC_URL="http://localhost:3000"

# --- ElevenLabs speech for the agent-less clients (optional) ---
# The voice call gets speech from ElevenLabs directly. The page panel and the Chrome extension only
# have text, so /api/speak synthesises it server-side — the key must never reach the extension
# bundle, which anyone who installs it can read. Leave empty and both clients fall back to the
# browser's own voice: worse, but still spoken.
ELEVENLABS_API_KEY=""
# Any voice id from your ElevenLabs library. Defaults to a stock voice when unset.
ELEVENLABS_VOICE_ID=""
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"

# --- Voice per branch depth (optional) ---
# Labels of extra voices configured on the ElevenLabs agent (Agent > Voice > Multi-voice). The
# agent matches on the label, not the voice id. Leave these empty and everything speaks in the
# primary voice — the loop behaves identically either way.
# Depth 1, a side branch:
VOICE_LABEL_BRANCH=""
# Depth 2+, a branch off a branch. Falls back to VOICE_LABEL_BRANCH when unset.
VOICE_LABEL_DEEP=""

# --- Tuning ---
# Vector recall floor. Raise if the demo surfaces loose matches, lower if it surfaces nothing.
RECALL_MIN_SCORE="0.55"
# Runs needed before stored evidence overrides the classifier.
ROUTING_MIN_SAMPLES="2"

# --- LangSmith (optional, for the trace you show on stage) ---
# On: every branch run, every provider call, and every routing decision become one trace. Run the
# same question cold and again after a merge — the two traces differ at the `route` step, and the
# difference is stored evidence. That side-by-side is the learning claim.
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="mahogany"
